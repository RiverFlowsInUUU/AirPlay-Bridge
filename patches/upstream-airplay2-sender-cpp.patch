     int16_t frames[kFramesPerPacket * kChannels];
     fillFrames_(frames, kFramesPerPacket);
 
+    // 【开局淡入】消掉「会话开头那段静音 → 真实音频」的接缝。
+    //
+    // 背景：会话建立时 ring 还是空的（采集尚未送出数据），所以开头若干包
+    // 只能是补零的静音。等真实音频接上时：
+    //   ① 波形是接在静音后面的，接缝处是一级台阶（实测 2604，而该段音乐
+    //      的峰值只有约 3200 —— 台阶几乎和音乐等响，听感就是一声「咔」）；
+    //   ② 接收端收到一段纯数字静音后，输出级进入空闲态，随后被满幅信号
+    //      突然叫醒，唤醒过程本身也会有一段失真（持续小半秒的喀啦）。
+    //
+    // 淡入同时压住这两点：让音频从 0 平滑升上来，输出级在这段里温和地
+    // 醒过来，接缝也不再是台阶。
+    //
+    // 触发方式是「第一段非静音音频出现时」而不是「会话一开始」——
+    // 因为会话开头本来就是静音，若从一开始计时，淡入会被那段静音耗掉，
+    // 真正接上时台阶依旧。
+    if (fadeInLeft_ < 0) {
+        for (int i = 0; i < kFramesPerPacket * kChannels; ++i) {
+            const int v = int(frames[i]);
+            if (v > 32 || v < -32) { fadeInLeft_ = kFadeInFrames; break; }
+        }
+    }
+    if (fadeInLeft_ > 0) {
+        for (int i = 0; i < kFramesPerPacket; ++i) {
+            const double g = static_cast<double>(kFadeInFrames - fadeInLeft_)
+                             / static_cast<double>(kFadeInFrames);
+            frames[i * kChannels + 0] =
+                static_cast<int16_t>(frames[i * kChannels + 0] * g);
+            frames[i * kChannels + 1] =
+                static_cast<int16_t>(frames[i * kChannels + 1] * g);
+            if (--fadeInLeft_ <= 0) break;
+        }
+    }
+
     // 12-byte RTP header (big-endian, shared by AP1 + AP2).
     std::string header;
     header.reserve(12);
