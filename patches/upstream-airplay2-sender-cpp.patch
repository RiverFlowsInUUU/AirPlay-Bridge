+    // 运行时设置端到端延迟（毫秒）。必须在 start() 之前调用：
+    // 这个值会写进 SETUP 的 latencyMax/Min，并作为 RTP 时间戳的基准偏移。
+    // 调小可以降低延迟，但太小会导致接收端 underrun（爆音）。
+    // 合理范围约 100-2000 ms。
+    void setLatencyMs(int ms) {
+        if (ms < 60)    ms = 60;      // 低于 60ms 基本都撑不住
+        if (ms > 1000)  ms = 1000;
+        // 44100 Hz 下每毫秒 44.1 帧
+        latency_ = static_cast<uint32_t>(ms * 44100 / 1000);
+        latencyMs_ = ms;
+    }
+    int latencyMs() const { return latencyMs_; }
