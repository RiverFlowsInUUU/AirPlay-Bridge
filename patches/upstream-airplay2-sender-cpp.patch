+// 本仓库的补丁给发送端加了「开局淡入」（见 raop_sender.cpp 的 sendAudioPacket_）：
+// 会话里第一段非静音音频出现后，前 kFadeTestFrames 帧乘一个 0 -> 1 的线性增益。
+//
+// 淡入是**整条流**的特性，不是某个包的特性 —— 所以这里按「第几个被发出的包」
+// 把增益算出来。每条用例第一个包都是 n=0。
+constexpr int kFadeTestFrames = 8820;   // 与 raop_sender.cpp 的 kFadeInFrames 一致
+constexpr int kFadeTestPacket = 352;    // 与 kFramesPerPacket 一致
+
+// 第 nth 个包（0 基）里第 i 帧的淡入增益。窗口走完之后恒为 1.0。
+double fadeGain(int nth, int i) {
+    const int done = nth * kFadeTestPacket + i;
+    if (done >= kFadeTestFrames) return 1.0;
+    return double(done) / double(kFadeTestFrames);
+}
+
+// 整个包都还在淡入窗口里时，返回期望的 pcm；否则返回 false（调用方自己算）。
+bool rampExpectFaded(size_t samples, int nth, std::vector<int16_t>& out,
+                     int16_t seed = 0) {
+    const int done = nth * kFadeTestPacket + int(samples / 2);
+    if (done > kFadeTestFrames) return false;          // 窗口走完了，用原值
+    out.resize(samples);
+    for (size_t i = 0; i < samples / 2; ++i) {
+        // ★ ramp 是**按样本**递增的（ring 里是 L,R,L,R…），
+        //   所以帧 i 的左声道是样本 2i、右声道是样本 2i+1。
+        //   我第一版把 i 当成样本号，源值恒为实际的一半 ——
+        //   测试报「每个索引都是 2.0x」才定位到。
+        const int16_t srcl = int16_t((seed + int(i) * 2 * 37) & 0x7FFF);
+        const int16_t srcr = int16_t((seed + int(i * 2 + 1) * 37) & 0x7FFF);
+        // 两个声道都要乘 —— 实现里 frames[i*2+0] 和 [i*2+1] 都乘了。
+        const double g = fadeGain(nth, int(i));
+        out[i * 2 + 0] = int16_t(int(srcl) * g);
+        out[i * 2 + 1] = int16_t(int(srcr) * g);
+    }
+    return true;
+}
