diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6f5c72d..c9d488b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -43,7 +43,12 @@ target_include_directories(ed25519 PUBLIC
 # warnings for our own code only (the dependencies keep their flags).
 function(airplay_warnings target)
     if(MSVC)
-        target_compile_options(${target} PRIVATE /W4)
+        # /utf-8: the sources are UTF-8 (they carry Chinese comments). Without
+        # it MSVC decodes them in the system codepage (936/GBK here), and a
+        # UTF-8 sequence whose last byte is a GBK lead byte (e.g. U+FF0C ",",
+        # ...\xef\xbc\x8c) swallows the following newline, merging the comment
+        # with the next declaration and making members "undeclared".
+        target_compile_options(${target} PRIVATE /W4 /utf-8)
         target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
     else()
         target_compile_options(${target} PRIVATE -Wall -Wextra)
diff --git a/src/raop_sender.cpp b/src/raop_sender.cpp
index 0e282e1..f0978db 100644
--- a/src/raop_sender.cpp
+++ b/src/raop_sender.cpp
@@ -1548,6 +1548,18 @@ void RaopSender::handlePairSetupM4_(const std::string& body) {
         ap2_->controlIn  = hkdfSha512("Control-Salt",
                                       "Control-Read-Encryption-Key",
                                       ap2_->sharedSecret, 32);
+        // 事件通道密钥：瞬态配对也必须派生这四把里的另两把。
+        // eventPort 是反向连接，读写密钥与控制通道相反：
+        //   用 Events-Write 解密接收端推来的事件，
+        //   用 Events-Read  加密我们回的 200 OK。
+        // 缺了这两把，接收端推来的请求无法解密、不回 ack，
+        // 它会在约 30 秒后主动拆掉整条会话。
+        ap2_->eventIn  = hkdfSha512("Events-Salt",
+                                    "Events-Write-Encryption-Key",
+                                    ap2_->sharedSecret, 32);
+        ap2_->eventOut = hkdfSha512("Events-Salt",
+                                    "Events-Read-Encryption-Key",
+                                    ap2_->sharedSecret, 32);
         pairStage_ = PairStage::Done;
         afterAuthOk_();
         return;
@@ -1859,8 +1871,12 @@ void RaopSender::sendAp2SetupStream_() {
     stream.emplace_back("controlPort", Value::integer(localControlPort_));
     stream.emplace_back("ct", Value::integer(2));        // ALAC
     stream.emplace_back("isMedia", Value::boolean(true));
-    stream.emplace_back("latencyMax", Value::integer(88200));
-    stream.emplace_back("latencyMin", Value::integer(11025));
+    // 调度窗口同步缩小（原 88200/11025 = 2s/0.25s）。
+    // 这是允许接收端缓冲的上限，调小才能压住延迟。
+    // 调度窗口跟随运行时设置的延迟：上限给 2 倍余量，下限给 1/3。
+    // 这个窗口是"允许接收端缓冲的范围"，必须跟 latency_ 匹配。
+    stream.emplace_back("latencyMax", Value::integer(int(latency_) * 2));
+    stream.emplace_back("latencyMin", Value::integer(int(latency_) / 3));
     stream.emplace_back("shk", Value::bytes(ap2_->audioKey));
     stream.emplace_back("spf", Value::integer(352));     // samples per frame
     stream.emplace_back("sr", Value::integer(44100));
