         afterAuthOk_();
         return;
@@ -1859,6 +1874,26 @@ void RaopSender::sendAp2SetupStream_() {
     stream.emplace_back("controlPort", Value::integer(localControlPort_));
     stream.emplace_back("ct", Value::integer(2));        // ALAC
     stream.emplace_back("isMedia", Value::boolean(true));
+    // 调度窗口 —— **这是接收端的能力声明，不是我们的延迟设置**。
+    //
+    // 【2026-10-17 更正】这里曾经被改成 `latencyMax = latency_ * 2`，
+    // 理由是"上限给 2 倍余量"——**那个理由是编的**，没有任何依据。
+    //
+    // 查 pyatv 官方实现（protocols/airplayv2.py）：
+    //     "latencyMax": 88200,     # 2.0s  ← 固定常量
+    //     "latencyMin": 11025,     # 250ms ← 固定常量
+    // 而它的 latency（实际用的延迟）是 `22050 + sample_rate` = 1.5s，
+    // **单独一个变量，从不参与这两个字段的计算**。
+    //
+    // 两者的语义完全不同：
+    //   latencyMax/Min = "我（接收端）能垫多深" —— 能力范围，不该由发送端缩小
+    //   latency_       = "我们实际用多深"       —— 通过 RTP 时间戳和 sync 包表达
+    //
+    // 把 max 改成 latency_*2，等于**替接收端把它自己声明的能力上限砍掉**
+    // （250ms 档位下从 2 秒砍到 500ms）。若接收端按 max 决定可用缓冲，
+    // 那正是我们想避免的 underrun 来源。
+    //
+    // 所以恢复成上游的固定值。真要让接收端垫得更浅，改的是 latency_，不是这里。
     stream.emplace_back("latencyMax", Value::integer(88200));
     stream.emplace_back("latencyMin", Value::integer(11025));
     stream.emplace_back("shk", Value::bytes(ap2_->audioKey));
